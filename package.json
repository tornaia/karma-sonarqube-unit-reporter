{
  "name": "karma-sonarqube-unit-reporter",
  "version": "1.0.0",
  "description": "A Karma plugin. Report results in SonarQube generic test execution (sonar-unit-tests) XML format.",
  "main": "index.js",
  "files": [
    "index.js",
    "src/"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "npm run lint && npm run test:unit",
    "test:unit": "jasmine --config=test/jasmine.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tornaia/karma-sonarqube-unit-reporter.git"
  },
  "homepage": "https://github.com/tornaia/karma-sonarqube-unit-reporter#readme",
  "bugs": {
    "url": "https://github.com/tornaia/karma-sonarqube-unit-reporter/issues"
  },
  "keywords": [
    "junit",
    "karma-plugin",
    "karma-reporter",
    "sonarqube",
    "sonar",
    "sonar-generic-coverage"
  ],
  "author": "Andras Tornai <tornai.andras.ede@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "karma": ">=0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.12.0",
    "jasmine": "^7.0.0",
    "prettier": "^3.9.6"
  }
}
